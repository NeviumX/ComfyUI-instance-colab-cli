# comfyui-instance-colab-cli の設定。各スクリプトが bash で source する。
# 自分だけの値は config.local.env に書くと上書きできる。

# ===== Colab ランタイム =====
COLAB_SESSION=comfyui         # colab CLI のセッション名。ssh_config の ProxyCommand にも渡る
GPU=L4                        # T4 / L4 / G4 / H100 / A100
HIGH_MEM=0                    # 1 なら --high-mem を付ける。Colab Pro/Pro+ が必要。L4 では無視される
EXPECT_GPU_REGEX=''           # nvidia-smi の GPU 名がこれに一致しないときは ON_GPU_MISMATCH に従う。空なら GPU の値で判定する
ON_GPU_MISMATCH=ask           # ask: 確認する / stop: ランタイムを止めて終了 / continue: そのまま続行

# ===== Google ドライブ =====
USE_DRIVE=1                   # 1 なら Google ドライブをマウントし、DRIVE_FOLDER/models のモデルを使う
DRIVE_FOLDER=ComfyUI-Colab    # マイドライブからの相対パス。モデルと環境はこのフォルダーに置く
SAVE_ENVIRONMENT=1            # 1 なら ComfyUI 本体・カスタムノード・設定・ワークフローを DRIVE_FOLDER/environment に保存する
RESTORE_ENVIRONMENT=1         # 1 なら新しいランタイムで、保存した環境を復元する。0 なら新しく作る
SAVE_INTERVAL_SEC=120         # 起動中に環境を保存する間隔の秒数。60 以上。ランタイムを削除する前にも保存する

# ===== Colab VM 側の ComfyUI =====
COMFY_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFY_REF=latest              # latest なら最新のリリースタグ。v0.3.60 のようなタグやブランチ名も指定できる。保存した環境が無いときだけ使う
AUTO_UPDATE=0                 # 1 なら起動のときに新しいリリースがあれば、更新してから起動する。0 なら知らせるだけで、update.bat で更新する
INSTALL_MANAGER=1             # 1 なら ComfyUI-Manager を入れる
CUSTOM_NODES=''               # 入っていなければ入れるカスタムノードの git URL。空白で区切る
APT_PACKAGES=''               # 追加で入れる apt パッケージ。空白で区切る
USE_SAGE_ATTENTION=1          # 1 なら SageAttention を入れて GPU で試し、使えれば --use-sage-attention で起動する。使えなければ標準の attention で起動する
COMFY_EXTRA_ARGS=''           # main.py に追加で渡す引数。空白で区切る。例: '--fast fp16_accumulation'
REMOTE_PORT=8188              # Colab VM 側のポート。ComfyUI は 127.0.0.1 だけで待ち受ける
COMFY_BASE=/content/comfy-session  # Colab VM 上で ComfyUI と venv などを置く場所
REMOTE_LOG=/content/comfyui.log

# ===== 手元の WSL / Windows =====
COMFY_COLAB_LANG="${COMFY_COLAB_LANG:-}" # 表示する言語。空なら自動で、日本語の環境なら ja、それ以外は en。ja か en で固定できる
LOCAL_PORT=8188               # http://127.0.0.1:<この番号> で ComfyUI を使う。Comfy Desktop の Remote Connection にも同じ URL を入れる
OPEN_BROWSER=1                # 1 なら起動完了時に Windows のブラウザで ComfyUI を開く
PULL_OUTPUTS_ON_STOP=1        # 1 ならランタイムを削除する前に、ComfyUI の output フォルダーを OUTPUT_DIR へコピーする
OUTPUT_DIR=outputs            # 出力のコピー先。相対パスはこのフォルダーから見た場所
HEALTH_TIMEOUT_MIN=30         # 起動完了を待つ上限の分数
POLL_SEC=10                   # 起動待ちの確認間隔の秒数
SETUP_RETRIES=2               # ポート使用中などで落ちたときに Colab 側でやり直す回数
WATCH_SEC=30                  # 起動後に ComfyUI が落ちていないか確認する間隔の秒数
BUTTON_POLL_SEC=2             # ComfyUI の画面の停止ボタンが押されたかを確認する間隔の秒数
